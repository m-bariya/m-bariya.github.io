<ul class="card-text font-weight-light list-group list-group-flush">
  {% for content in data[1] %}
    <li class="list-group-item">
      <h6 class="title font-weight-bold">{{ content.title }}</h6>
      <h6 style="font-size: 0.95rem">{{ content.awarder }}</h6>
      {% if content.date %}
        {% assign date = content.date | split: '-' | join: '.' %}
        <p class="cv-date">{{ date }}</p>
      {% endif %}
      <h6 style="font-size: 0.95rem">{{ content.summary }}</h6>
    </li>
  {% endfor %}
</ul>
